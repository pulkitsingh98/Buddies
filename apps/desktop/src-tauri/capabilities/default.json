{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app-windows",
  "description": "Settings, pet-creator and friends windows.",
  "windows": ["settings", "creator", "friends", "chores", "onboarding"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "updater:default",
    "process:allow-restart",
    "log:default",
    "autostart:default"
  ]
}
